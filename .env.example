# Local synthetic development only. Never use these values in production.
API_ORIGIN=http://127.0.0.1:8080
DB_URL=jdbc:postgresql://localhost:5438/atlas
DB_USER=atlas
DB_PASSWORD=local-synthetic-only
LOCAL_DEMO_PASSWORD=atlas-demo
# Production: inject values from a secret manager; enable prod profile only.
# APP_ORIGIN=https://your-approved-host
# OIDC_ISSUER=https://your-provider/realms/your-realm
# OIDC_CLIENT_ID=atlas-web
# OIDC_CLIENT_SECRET=from-secret-manager
# Documents: local/oidc-demo only; ClamAV loopback port 3311, bundled demo signatures.
# Default Maven development root: backend/.local/private-documents (ignored, private).
# Set the same absolute canonical root for Java and recovery scripts when overriding:
# ATLAS_DOCUMENTS_LOCAL_ROOT=/your/private/persistent/development/root
# Production private object storage/encryption and validated scanner freshness are not configured.
# Exact issuer used when HR independently reviews a newly hired employee's subject binding.
# OIDC profile defaults to its configured Keycloak issuer; local demonstration must set explicitly.
# INITIAL_IDENTITY_ISSUER=http://127.0.0.1:8088/realms/atlas
# Optional in-process talent approval reminders. HR must explicitly configure the tenant policy.
# No email delivery or provider credential is used; outcomes are committed in-app notices.
ATLAS_TALENT_REMINDERS_ENABLED=false
ATLAS_TALENT_REMINDERS_POLL_MS=60000
