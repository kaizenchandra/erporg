    "/api/csrf": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session setup",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "headerName": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "token",
                    "headerName"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth-mode": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session setup",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "local",
                        "oidc"
                      ]
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Local profile only: URL-encoded username/password plus CSRF header",
        "responses": {
          "204": {
            "description": "Authenticated; session rotates"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Missing CSRF or unavailable profile"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Invalidate session; OIDC mode redirects through provider logout",
        "responses": {
          "204": {
            "description": "Local session ended"
          },
          "302": {
            "description": "OIDC provider end-session redirect"
          }
        }
      }
    },
    "/api/v1/directory": {
      "get": {
        "summary": "Search authorised effective-dated employees with server pagination",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          },
          "400": {
            "description": "Invalid query bounds or sort direction"
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "department",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40,
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 8
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            }
          }
        ]
      }
    },
