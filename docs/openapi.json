{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas Phase 1 API",
    "version": "0.1.0",
    "description": "Only implemented paths. UI sort/filter/pagination is over bounded authorised arrays in this phase. No arbitrary tenant input. Cookie sessions and CSRF. Sensitive responses no-store. Decision replay returns 409; submission replay returns same request."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "summary": "Get server-resolved identity",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Actor"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          }
        }
      }
    },
    "/api/v1/employees": {
      "get": {
        "summary": "List authorised employee records (maximum 1000)",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          }
        }
      }
    },
    "/api/v1/requests": {
      "get": {
        "summary": "List scoped approval requests (maximum 500)",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChangeRequest"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          }
        }
      },
      "post": {
        "summary": "Submit effective-dated change",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeRequest"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          },
          "400": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale version, final decision or incompatible replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 32KiB"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitChange"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/requests/{id}/decision": {
      "post": {
        "summary": "Approve or reject independently",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeRequest"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated; may have empty body"
          },
          "403": {
            "description": "Forbidden or missing CSRF"
          },
          "429": {
            "description": "Rate limited; retry after response header"
          },
          "400": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale version, final decision or incompatible replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 32KiB"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
